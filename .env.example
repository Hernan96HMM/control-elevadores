# =============================================================================
# control-autoelevadores — variables de entorno
# Copiar a .env y completar. El .env NUNCA se versiona (está en .gitignore).
# En el servidor va en ./control-autoelevadores/.env (env_file del compose).
# =============================================================================

# --- Runtime Next.js ---------------------------------------------------------
NODE_ENV=production
PORT=3000
# Obligatorio: sin esto el server standalone puede escuchar solo en la IP
# interna del contenedor y el healthcheck / Nginx no llegan.
HOSTNAME=0.0.0.0

# --- Datos persistentes (rutas ABSOLUTAS dentro del contenedor) --------------
# Todo vive en /app/data = bind mount ./control-autoelevadores/data del host.
DB_PATH=/app/data/control-autoelevadores.db
UPLOADS_DIR=/app/data/uploads
# Aplica migraciones al arrancar el contenedor (idempotente). false = solo a mano.
AUTO_MIGRATE=true

# --- Auth.js -----------------------------------------------------------------
# URL pública detrás de Nginx. También se usa para armar la URL de los QR.
NEXTAUTH_URL=http://control-autoelevadores.sica
# Secreto para firmar las sesiones. Generar con:  openssl rand -base64 32
AUTH_SECRET=
# Obligatorio detrás de Nginx sobre HTTP interno.
AUTH_TRUST_HOST=true

# --- Administrador inicial (lo crea `npm run db:seed:prod` si no existe) -----
ADMIN_USER=admin
# Mínimo 8 caracteres. Cambiarla desde el panel después del primer ingreso.
ADMIN_PASSWORD=

# --- Email ante falla crítica (OPCIONAL) -------------------------------------
# Si SMTP_HOST queda vacío el envío de mails se deshabilita sin afectar la app.
SMTP_HOST=
SMTP_PORT=25
# true para SMTPS (puerto 465); false para texto plano / STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=control-autoelevadores@sica
# Poner false solo si el SMTP interno usa un certificado autofirmado.
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Destinatarios fijos separados por coma (además de los que cargue el admin en el panel).
ALERT_EMAILS=
